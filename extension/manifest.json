{
  "manifest_version": 3,
  "name": "foxrunner — agent tasks that resume",
  "version": "0.1.2",
  "description": "Durable agent tasks in Firefox: steps that resume, schedules, and a headless helper.",
  "icons": { "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png" },
  "browser_specific_settings": {
    "gecko": {
      "id": "foxrunner@pooriaarab",
      "strict_min_version": "153.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": ["storage", "alarms"],
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_icon": { "48": "icons/icon-48.png", "96": "icons/icon-96.png" },
    "default_title": "foxrunner",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["http://127.0.0.1/*"],
      "js": ["e2e-bridge.js"]
    }
  ]
}
